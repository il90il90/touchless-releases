# Touchless relay settings. start.cmd / start.sh copies this to .env and fills it in.
# Edit by hand only if you run docker compose yourself. Every value is optional
# except RELAY_LAN_IP when you use docker-compose.lan.yml.

# Relay image (loaded from touchless-relay-image.tar.gz). Leave as is.
TOUCHLESS_IMAGE=touchless-relay:latest

# Port on this computer (127.0.0.1 and, in LAN mode, your Wi-Fi IP).
RELAY_PORT=8787

# Setup page + settings, opened on THIS computer only: http://127.0.0.1:<ADMIN_PORT>
ADMIN_PORT=8789

# LAN mode: this computer's PRIVATE Wi-Fi/Ethernet IPv4, e.g. 192.168.1.50.
# Windows: ipconfig  ·  macOS: ipconfig getifaddr en0  ·  Linux: hostname -I
# The phone then uses http://<this IP>:8787 . Never port-forward it on the router.
RELAY_LAN_IP=

# 1 ONLY behind a trusted reverse proxy (the TLS overlay sets it for you). Otherwise 0.
TRUST_PROXY=0

# Optional: your PUBLIC https address (TLS overlay, VPN or tunnel), e.g. https://relay.example.com.
# Shown in the startup guide (docker compose logs relay). Must be https. Empty = local only.
RELAY_PUBLIC_URL=

# ---- Public HTTPS overlay (docker-compose.tls.yml) only ----
# A real domain whose DNS points at this computer, and an email for the certificate.
RELAY_DOMAIN=relay.example.com
ACME_EMAIL=you@example.com
